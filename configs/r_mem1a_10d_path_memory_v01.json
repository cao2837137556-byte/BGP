{
  "phase": "R-MEM-1A",
  "description": "10-day canonical path-memory sidecar smoke for foreground poisoning robustness repair.",
  "target_date": "2024-04-16",
  "history_days": 10,
  "canonical_collectors": [
    "route-views.sg",
    "rrc00"
  ],
  "source": {
    "source_root": "data/runs",
    "source_run_id": "r_mem1a_10d_sources_v01",
    "file_kind": "raw",
    "prefer_run_ids": [
      "r_mem1a_10d_sources_v01",
      "s2a_baseline_v01_pilot_6h_april16",
      "s2a_expanded_v01_pilot_6h_april16",
      "s2a_attack1_family_expansion_6h_april16_v01"
