    "mature_min_active_micro_batches": 12,
    "mature_min_collector_days": 3,
    "mature_min_span_sec": 172800,
    "recent_only_days": 2,
    "short_lived_span_sec": 21600
  },
  "online_evaluation_contract": {
    "micro_batch_units": [
      "5m",
      "15m"
    ],
    "required_metrics": [
      "overall_compression",
      "per_batch_foreground_rows_p50",
      "per_batch_foreground_rows_p90",
      "per_batch_foreground_rows_p99",
