        "threat_model": "detection_data_poisoning",
        "definition": "Crafted control-plane announcements before the attack pollute public-monitor-derived history, novelty, role, or path memory used by detection.",
        "paper_role": "core"
      },
      {
        "threat_model": "visibility_evasion",
        "definition": "The attack changes public monitor observability, for example by subprefix plus NO_EXPORT or collector-asymmetry constraints.",
        "paper_role": "core"
      }
    ],
    "not_core_targets": [
      {
        "threat_model": "as_path_poisoning_for_traffic_engineering",
        "definition": "Classical AS-path poisoning to influence route choice is terminology-relevant but not the main data-poisoning target in this benchmark.",
        "paper_role": "terminology_caveat"
      }
    ]
  },
  "global_forbidden_claims": [
    "NO_EXPORT present is not attack truth.",
    "NO_EXPORT absent is not safe.",
    "RPKI invalid is not attack truth.",
    "RPKI valid is not benign.",
    "AS-rel diagnostic is not route leak truth.",
    "public-invisible control-plane events are not foreground misses unless the observability contract says the public monitor should see them.",
    "Legacy final/high/needs/low labels are not truth or guard signals.",
    "This protocol does not train learning models.",
    "This protocol does not change online foreground suppression.",
    "Unpaired poisoned/evasive results are not valid paper evidence."
  ],
