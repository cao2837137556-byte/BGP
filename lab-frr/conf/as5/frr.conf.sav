frr version 8.4_git
frr defaults traditional
hostname 1fe39d9bce39
domainname localdomain
log stdout
no ipv6 forwarding
service integrated-vtysh-config
!
ip route 10.1.1.0/24 Null0
!
router bgp 5
 no bgp ebgp-requires-policy
 neighbor 172.16.35.3 remote-as 3
 !
 address-family ipv4 unicast
  neighbor 172.16.35.3 route-map HIJACK out
 exit-address-family
exit
!
route-map HIJACK permit 10
 set community no-export additive
exit
!
